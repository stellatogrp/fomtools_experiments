#!/bin/bash
# Route every `make` (the controller's and the agent's) through bridge/onnode:
# in per-job mode each make is a short Slurm job on a 7H12 + A100 node.
# `make clean-solver` only deletes files, so it runs right here.
# Refuse calls from stale or foreign processes: the current controller writes
# $ROOT/RUN_TOKEN and exports FOM_RUN_TOKEN; anything else (e.g. an orphaned agent
# from an earlier controller) gets no builds, verifies or Slurm jobs.
if [[ -z "${SLURM_STEP_ID:-}" && -n "${ROOT:-}" && -f "$ROOT/RUN_TOKEN" \
      && "${FOM_RUN_TOKEN:-}" != "$(cat "$ROOT/RUN_TOKEN")" ]]; then
  echo "bridge: run token mismatch; refusing (stale or foreign process)" >&2
  exit 97
fi
compute=1
for arg in "$@"; do
  [[ $arg == clean-solver ]] && compute=0
done
for arg in "$@"; do
  case "$arg" in
    verify|bench|profile|fixed|*_bin|*.o) compute=1 ;;
  esac
done
[[ $compute == 0 ]] && exec /usr/bin/make "$@"
exec "$(dirname "$0")/onnode" /usr/bin/make "$@"
